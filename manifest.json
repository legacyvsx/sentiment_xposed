{
  "manifest_version": 3,
  "name": "Sentiment eXposed",
  "version": "1.0.0",
  "description": "Colorizes tweets by sentiment using xAI Grok API",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Sentiment Analyzer"
  }
}
